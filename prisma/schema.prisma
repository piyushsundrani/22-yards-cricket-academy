generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id               String        @unique
  full_name                String
  date_of_birth            DateTime      @db.Date
  gender                   Gender
  school                   String?
  aadhar_number            String?
  email                    String?
  blood_group              String?
  father_name              String?
  mother_name              String?
  guardian_name            String
  contact_number           String
  occupation               String?
  emergency_contact_name   String?
  emergency_contact_number String?
  address                  String?
  batch                    Batch
  level                    Level
  batting_style            BattingStyle?
  bowling_style            BowlingStyle?
  referral_source          String?
  enrollment_date          DateTime      @default(now()) @db.Date
  photo_url                String?
  is_active                Boolean       @default(true)
  created_at               DateTime      @default(now()) @db.Timestamptz()
  billings                 Billing[]

  @@map("students")
}

model Billing {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receipt_number String        @unique
  student_id     String        @db.Uuid
  student        Student       @relation(fields: [student_id], references: [id])
  fee_type       FeeType
  amount         Decimal       @db.Decimal(10, 2)
  payment_month  DateTime      @db.Date
  payment_date   DateTime?     @db.Date
  due_date       DateTime      @db.Date
  valid_till     DateTime      @db.Date
  payment_mode   PaymentMode?
  status         BillingStatus
  notes          String?
  created_at     DateTime      @default(now()) @db.Timestamptz()

  @@map("billing")
}

model User {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String   @unique
  role       Role
  full_name  String
  created_at DateTime @default(now()) @db.Timestamptz()

  @@map("users")
}

enum Gender {
  Male
  Female
  Other
}

enum Batch {
  Morning
  Evening
  Weekend
}

enum Level {
  Beginner
  Intermediate
  Advanced
}

enum FeeType {
  Monthly
  Quarterly
  Annual
}

enum PaymentMode {
  Cash
  UPI
  Bank_Transfer @map("Bank Transfer")
}

enum BillingStatus {
  Paid
  Pending
  Overdue
  Expired
}

enum BattingStyle {
  Right_Hand @map("Right-hand")
  Left_Hand  @map("Left-hand")
}

enum BowlingStyle {
  Fast
  Medium
  Spin
  Not_Applicable @map("N/A")
}

enum Role {
  Admin
  Staff
}

model Staff {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id     String            @unique
  full_name    String
  phone        String
  email        String?
  role         StaffRole
  joining_date DateTime          @db.Date
  is_active    Boolean           @default(true)
  created_at   DateTime          @default(now()) @db.Timestamptz()
  attendance   StaffAttendance[]

  @@map("staff")
}

model StaffAttendance {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id   String           @db.Uuid
  staff      Staff            @relation(fields: [staff_id], references: [id])
  date       DateTime         @db.Date
  status     AttendanceStatus
  notes      String?
  created_at DateTime         @default(now()) @db.Timestamptz()

  @@unique([staff_id, date])
  @@map("staff_attendance")
}

enum StaffRole {
  Head_Coach       @map("Head Coach")
  Coach
  Assistant_Coach  @map("Assistant Coach")
  Admin
  Support
}

enum AttendanceStatus {
  Present
  Absent
  Leave
  Half_Day @map("Half Day")
}

model Expense {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expense_id   String          @unique
  date         DateTime        @db.Date
  category     ExpenseCategory
  amount       Decimal         @db.Decimal(10, 2)
  description  String
  paid_by      String?
  payment_mode PaymentMode?
  notes        String?
  created_at   DateTime        @default(now()) @db.Timestamptz()

  @@map("expenses")
}

enum ExpenseCategory {
  Ground_Maintenance @map("Ground Maintenance")
  Equipment
  Salary
  Utilities
  Travel
  Food_Refreshment   @map("Food & Refreshment")
  Miscellaneous
}
